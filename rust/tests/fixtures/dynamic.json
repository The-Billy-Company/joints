{
  "name": "dynamic_contract",
  "rules": {
    "document": {"type": "CHOICE", "members": [{"type": "SYMBOL", "name": "ranked"}, {"type": "SYMBOL", "name": "plain"}]},
    "ranked": {"type": "PREC_DYNAMIC", "value": 2, "content": {"type": "SEQ", "members": [
      {"type": "STRING", "value": "x"},
      {"type": "PREC_DYNAMIC", "value": -5, "content": {"type": "STRING", "value": "y"}}
    ]}},
    "plain": {"type": "SEQ", "members": [{"type": "STRING", "value": "x"}, {"type": "STRING", "value": "y"}]}
  },
  "conflicts": [["ranked", "plain"]]
}
