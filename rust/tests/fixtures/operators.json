{
  "name": "operator_contract",
  "rules": {
    "document": {"type": "SYMBOL", "name": "expression"},
    "expression": {
      "type": "CHOICE",
      "members": [
        {"type": "PREC_LEFT", "value": 1, "content": {"type": "SEQ", "members": [
          {"type": "SYMBOL", "name": "expression"}, {"type": "STRING", "value": "+"}, {"type": "SYMBOL", "name": "expression"}
        ]}},
        {"type": "PREC_LEFT", "value": 2, "content": {"type": "SEQ", "members": [
          {"type": "SYMBOL", "name": "expression"}, {"type": "STRING", "value": "*"}, {"type": "SYMBOL", "name": "expression"}
        ]}},
        {"type": "PREC_RIGHT", "value": 3, "content": {"type": "SEQ", "members": [
          {"type": "SYMBOL", "name": "expression"}, {"type": "STRING", "value": "^"}, {"type": "SYMBOL", "name": "expression"}
        ]}},
        {"type": "SYMBOL", "name": "identifier"}
      ]
    },
    "identifier": {"type": "PATTERN", "value": "[a-z]+"}
  },
  "extras": [{"type": "PATTERN", "value": "\\s"}]
}
