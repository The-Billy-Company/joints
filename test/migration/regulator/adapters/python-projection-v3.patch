+    fn visit_stmt(&mut self, statement: &'a Stmt) {
+        if let Stmt::If(statement) = statement {
+            // Ruff 0.0.7's generic walker visits each elif test twice.
+            // Reference multiplicity follows each AST expression exactly once.
+            self.visit_expr(&statement.test);
+            self.visit_body(&statement.body);
+            for clause in &statement.elif_else_clauses {
+                self.visit_elif_else_clause(clause);
+            }
+        } else {
+            walk_stmt(self, statement);
+        }
+    }
