+#[cfg(test)]
+mod reference_tests {
+    use super::*;
+
+    fn handler_references(source: &str) -> (Vec<String>, Vec<String>) {
+        let parsed = ruff_python_parser::parse_module(source).unwrap();
+        let Stmt::Try(statement) = &parsed.syntax().body[0] else {
+            panic!("expected one try statement");
+        };
+        let ruff_python_ast::ExceptHandler::ExceptHandler(handler) = &statement.handlers[0];
+        let mut references = References::default();
+        references.visit_body(&handler.body);
+        references.names.sort();
+        references.attributes.sort();
+        (references.names, references.attributes)
+    }
+
+    fn assert_references(source: &str, names: &[&str], attributes: &[&str]) {
+        let expected = (
+            names.iter().map(|value| (*value).to_owned()).collect(),
+            attributes.iter().map(|value| (*value).to_owned()).collect(),
+        );
+        assert_eq!(handler_references(source), expected);
+    }
+
+    #[test]
+    fn if_and_elif_references_match_independent_cpython_ast_occurrences() {
+        assert_references(
+            "try:\n    f()\nexcept Error as e:\n    if e.status == 1:\n        pass\n",
+            &["e"],
+            &["status"],
+        );
+        assert_references(
+            "try:\n    f()\nexcept Error as e:\n    if e.status == 1:\n        pass\n    elif e.status == 2:\n        pass\n",
+            &["e", "e"],
+            &["status", "status"],
+        );
+    }
+
+    #[test]
+    fn compound_elif_references_match_independent_cpython_ast_occurrences() {
+        assert_references(
+            "try:\n    f()\nexcept Error as e:\n    if e.done():\n        pass\n    elif not e.cancelled() and e.exception() is None:\n        pass\n",
+            &["e", "e", "e"],
+            &["cancelled", "done", "exception"],
+        );
+        assert_references(
+            "try:\n    f()\nexcept Error as e:\n    if isinstance(e, One):\n        pass\n    elif isinstance(e, (mod.Two, mod.Three)):\n        pass\n",
+            &["One", "e", "e", "isinstance", "isinstance", "mod", "mod"],
+            &["Three", "Two"],
+        );
+    }
