+// In a with item, the grammar can attach `as target` to the final branch
+// of an unparenthesized conditional rather than around the whole expression.
+// Only that rightmost branch can carry the item's binding; aliases inside
+// call arguments or another context expression do not belong to this item.
+fn with_target(mut context: Node<'_>) -> Option<Node<'_>> {
+    loop {
+        context = expression(context);
+        if context.kind() == b"as_pattern" {
+            return context.child_by_field("alias").map(expression);
+        }
+        if context.kind() != b"conditional_expression" {
+            return None;
+        }
+        context = context
+            .named_children()
+            .filter(|child| child.kind() != b"comment")
+            .last()?;
+    }
+}
