+// Shared neutral facts use AST extents, while the complete CST keeps comments.
+// Descend through concrete children so closing delimiters remain part of the
+// extent; trimming source bytes would confuse comments with string contents.
+pub(crate) fn semantic_span(node: Node<'_>) -> regulator_core::node::Span {
+    let mut last = node;
+    while let Some(child) = last
+        .children()
+        .filter(|child| child.kind() != b"comment")
+        .last()
+    {
+        last = child;
+    }
+    let mut at = crate::lower::span(node);
+    at.end = last.byte_range().end;
+    at
+}
