// joints-python — import topology of the Python binding.
//
// The native ABI declarations sit below the owned Python handles, which sit
// below the public exports. The external test harness reads that public
// surface; product modules never read the tests or import up this stack.
//
// Named `joints-python` because the Zig package next door already answers to
// `joints` in `charter.zone`. One tree, two contracts, two names.
//
// Judged by `zoning verify` under the `python` dialect, from the repository
// root.

package joints-python {
    root     .
    language python
}

// Low to high, following the native declarations, owners, and public surface.
zones {
    native   joints/_native.py
    runtime  joints/_api.py
    binding  joints/__init__.py
    tests    tests/**
}

// Product imports stay in their own directory. The separate test harness
// exercises the installed public door through one explicitly ratified edge.
limit  reach to 0 hops
forbid cycles across directories

variance reach tests/test_binding.py -> joints/__init__.py
    because "The external binding harness exercises public exports from its sibling tests directory, outside the wheel. Retire this edge when the harness is colocated at the binding root without entering the published package."
