    "sqt": "'",
    "sqt_esc": "''",
    "dqt_ctn": "(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])+",
    "sqt_ctn": "(?:[^'\\r\\n]|'')+",
    "dqt_esc_nwl": "\\\\(?=\\r|\\n)",
    "dqt_esc_seq": "\\\\(?:[0abtnvfre \"/\\\\N_LP\\t]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})",
    "tag": "!(?:<[^>]+>|(?:[0-9A-Za-z-]*!)?[0-9A-Za-z%#;/?:@&=+$,_.~*'()\\[\\]-]*)",
    "acr_bgn": "&",
    "als_bgn": "\\*",
    "anchor_name": "[^\\s,\\[\\]{}]+",
    "pln_blk": "(?:[^\\s\\-?:,\\[\\]{}#&*!|>'\"%@`]|[?:-](?=[^\\s]))(?:[^\\s:#]|:(?=[^\\s])|(?<=\\S)#|[ \\t]+(?=[^\\s#]))*",
    "pln_flw": "(?:[^\\s\\-?:,\\[\\]{}#&*!|>'\"%@`]|[?:-](?=[^\\s,\\[\\]{}]))(?:[^\\s:#,\\[\\]{}]|:(?=[^\\s,\\[\\]{}])|(?<=\\S)#|[ \\t]+(?=[^\\s#,\\[\\]{}]))*",
    "blk_str_ctn": "[^\\r\\n]+"
