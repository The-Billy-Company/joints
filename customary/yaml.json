    "jsv_bgn": ":",
    "njv_bgn": ":(?=[ \\t\\r\\n,\\]}]|$)",
    "lit_bgn": "\\|[-+]?[0-9]*",
    "fld_bgn": ">[-+]?[0-9]*",
    "flw_seq_bgn": "\\[",
    "flw_seq_end": "\\]",
    "flw_map_bgn": "\\{",
