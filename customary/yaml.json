  "rules": [
    {
      "name": "eof_spends_a_blank_first",
      "why": ":877 - end of input answers BL while any indent is owed, and only then _eof",
      "phase": "bounded",
      "when": [["eof"], ["wanted", "_bl"]],
      "then": [["pop", "frames"], ["emit", "_bl", 0]]
    },
    {
      "name": "eof_is_the_end",
      "why": ":883",
      "phase": "bounded",
      "when": [["eof"], ["wanted", "_eof"]],
      "then": [["emit", "_eof", 0]]
    },

    {
      "name": "comment_closes_a_block_scalar_first",
      "why": ":856 - inside a block scalar a comment at or left of the frame is a dedent, not a comment",
      "phase": "bounded",
      "when": [
        ["wanted", "_br_blk_str_ctn"], ["wanted", "_bl"],
        ["probe", "comment"],
        ["lead", "=", "column"], ["lead", "<", "frames.top.width"]
      ],
      "then": [["pop", "frames"], ["emit", "_bl", 0]]
    },
    {
      "name": "comment_in_a_block_scalar_is_only_its_own_line",
      "why": ":860 true arm - with BR_BLK_STR_CTN live a comment counts only when no newline was crossed",
      "phase": "bounded",
      "when": [
        ["wanted", "_br_blk_str_ctn"],
        ["probe", "comment"],
        ["lead", "<", "column"]
      ],
      "then": [["emit", "comment"]]
    },
    {
      "name": "comment",
      "why": ":860 false arm - at a line start, or after a newline, or past the last token's column",
      "phase": "bounded",
      "when": [
        ["not_wanted", "_br_blk_str_ctn"],
        ["probe", "comment"]
      ],
      "then": [["emit", "comment"]]
    },

    {
      "name": "blank_closes_the_frame_it_left",
      "why": ":894 - a line at or left of the frame owes a dedent. The seq arm keeps a sibling '-' at the same column inside the sequence",
      "phase": "bounded",
      "when": [
        ["wanted", "_bl"],
        ["lead", "=", "column"], ["lead", "<", "frames.top.width"],
        ["no_probe", "seq_bgn"]
      ],
      "then": [["pop", "frames"], ["emit", "_bl", 0]]
    },
    {
      "name": "blank_closes_a_frame_a_dash_cannot_hold",
      "why": ":895 - the same close where the frame is not a sequence, so a '-' at this column does not continue it",
      "phase": "bounded",
      "when": [
        ["wanted", "_bl"],
        ["lead", "=", "column"], ["lead", "<", "frames.top.width"],
        ["frames.top.kind", "in", ["map", "str", "root"]]
      ],
      "then": [["pop", "frames"], ["emit", "_bl", 0]]
    },

    {
      "name": "directives_end",
      "why": ":1237 - '---' at column 0, and BL first if one is owed",
      "phase": "bounded",
      "when": [["probe", "drs_end"], ["bol"], ["wanted", "_bl"]],
      "then": [["pop", "frames"], ["emit", "_bl", 0]]
    },
    {
      "name": "directives_end_marker",
      "why": ":1247",
      "phase": "bounded",
      "when": [["probe", "drs_end"], ["bol"], ["wanted", "_s_drs_end"]],
      "then": [["emit", "_s_drs_end"]]
    },
    {
      "name": "document_end_marker",
      "why": ":1259 - '...' at column 0",
      "phase": "bounded",
      "when": [["probe", "doc_end"], ["bol"], ["wanted", "_s_doc_end"]],
      "then": [["emit", "_s_doc_end"]]
    },

    {
      "name": "block_sequence_same_line",
      "why": ":1222 PUSH_BGN_IND(IND_SEQ) - a '-' opens a sequence frame at its own column",
      "phase": "bounded",
      "when": [["wanted", "_r_blk_seq_bgn"], ["probe", "seq_bgn"], ["lead", "<", "column"]],
      "then": [
        ["push", "frames", ["+", "column", 1], "seq"],
        ["emit", "_r_blk_seq_bgn"]
      ]
    },
    {
      "name": "block_sequence_deeper",
      "why": ":1227",
      "phase": "bounded",
      "when": [
        ["wanted", "_br_blk_seq_bgn"], ["probe", "seq_bgn"],
        ["lead", "=", "column"], ["lead", ">=", "frames.top.width"]
      ],
      "then": [
        ["push", "frames", ["+", "column", 1], "seq"],
        ["emit", "_br_blk_seq_bgn"]
      ]
    },
    {
      "name": "block_sequence_level",
      "why": ":1232 MAY_PUSH_SPC_SEQ_IND - a '-' level with a map frame opens a sequence inside it, and level with a sequence frame is the next item",
      "phase": "bounded",
      "when": [
        ["wanted", "_b_blk_seq_bgn"], ["probe", "seq_bgn"],
        ["lead", "=", "column"], ["frames.top.kind", "in", ["map"]]
      ],
      "then": [
        ["push", "frames", ["+", "column", 1], "seq"],
        ["emit", "_b_blk_seq_bgn"]
      ]
    },
    {
      "name": "block_sequence_next_item",
      "why": ":1232 with cur_ind_typ already a sequence, so no push",
      "phase": "bounded",
      "when": [
        ["wanted", "_b_blk_seq_bgn"], ["probe", "seq_bgn"],
        ["lead", "=", "column"]
      ],
      "then": [["set", 0, ["+", "column", 1]], ["emit", "_b_blk_seq_bgn"]]
    },

    {
      "name": "explicit_key_same_line",
      "why": ":1145 - '? ' opens a map frame",
      "phase": "bounded",
      "when": [["wanted", "_r_blk_key_bgn"], ["probe", "key_bgn"], ["lead", "<", "column"]],
      "then": [["push", "frames", ["+", "column", 1], "map"], ["emit", "_r_blk_key_bgn"]]
    },
    {
      "name": "explicit_key_deeper",
      "why": ":1149",
      "phase": "bounded",
      "when": [
        ["wanted", "_br_blk_key_bgn"], ["probe", "key_bgn"],
        ["lead", "=", "column"], ["lead", ">=", "frames.top.width"]
      ],
      "then": [["push", "frames", ["+", "column", 1], "map"], ["emit", "_br_blk_key_bgn"]]
    },
    {
      "name": "explicit_key_level",
      "why": ":1153 - level with the frame, so the frame is already this map's",
      "phase": "bounded",
      "when": [
        ["wanted", "_b_blk_key_bgn"], ["probe", "key_bgn"], ["lead", "=", "column"]
      ],
      "then": [["emit", "_b_blk_key_bgn"]]
    },
    {
      "name": "flow_explicit_key_same_line",
      "why": ":1155",
      "phase": "bounded",
      "when": [["wanted", "_r_flw_key_bgn"], ["probe", "key_bgn"], ["lead", "<", "column"]],
      "then": [["emit", "_r_flw_key_bgn"]]
    },
    {
      "name": "flow_explicit_key_deeper",
      "why": ":1157",
      "phase": "bounded",
      "when": [["wanted", "_br_flw_key_bgn"], ["probe", "key_bgn"], ["lead", "=", "column"]],
      "then": [["emit", "_br_flw_key_bgn"]]
    },

    {
      "name": "flow_json_value_same_line",
      "why": ":1162 - a ':' after a JSON-like key needs no space after it",
      "phase": "bounded",
      "when": [["wanted", "_r_flw_jsv_bgn"], ["probe", "jsv_bgn"], ["lead", "<", "column"]],
      "then": [["emit", "_r_flw_jsv_bgn"]]
    },
    {
      "name": "flow_json_value_deeper",
      "why": ":1167",
      "phase": "bounded",
      "when": [["wanted", "_br_flw_jsv_bgn"], ["probe", "jsv_bgn"], ["lead", "=", "column"]],
      "then": [["emit", "_br_flw_jsv_bgn"]]
    },
    {
      "name": "block_value_same_line",
      "why": ":1183 PUSH_BGN_IND(IND_MAP)",
      "phase": "bounded",
      "when": [["wanted", "_r_blk_val_bgn"], ["probe", "val_bgn"], ["lead", "<", "column"]],
      "then": [["push", "frames", ["+", "column", 1], "map"], ["emit", "_r_blk_val_bgn"]]
    },
    {
      "name": "block_value_deeper",
      "why": ":1188",
      "phase": "bounded",
      "when": [
        ["wanted", "_br_blk_val_bgn"], ["probe", "val_bgn"],
        ["lead", "=", "column"], ["lead", ">=", "frames.top.width"]
      ],
      "then": [["push", "frames", ["+", "column", 1], "map"], ["emit", "_br_blk_val_bgn"]]
    },
    {
      "name": "block_value_level",
      "why": ":1193",
      "phase": "bounded",
      "when": [["wanted", "_b_blk_val_bgn"], ["probe", "val_bgn"], ["lead", "=", "column"]],
      "then": [["emit", "_b_blk_val_bgn"]]
    },
