  "classes": {
    "schema_blk_r": [
      ["~|null|Null|NULL", "_r_sgl_pln_nul_blk"],
      ["true|True|TRUE|false|False|FALSE", "_r_sgl_pln_bol_blk"],
      ["[-+]?[0-9]+|0o[0-7]+|0x[0-9a-fA-F]+", "_r_sgl_pln_int_blk"],
      ["[-+]?(?:[0-9]*\\.[0-9]+|[0-9]+\\.[0-9]*)(?:[eE][-+]?[0-9]+)?|[-+]?[0-9]+[eE][-+]?[0-9]+|[-+]?\\.(?:inf|Inf|INF)|\\.(?:nan|NaN|NAN)", "_r_sgl_pln_flt_blk"],
      ["[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}(?:[Tt]|[ \\t]+)[0-9]{1,2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]*)?(?:[ \\t]*(?:Z|[-+][0-9]{1,2}(?::[0-9]{2})?))?", "_r_sgl_pln_tms_blk"],
      ["(?s).*", "_r_sgl_pln_str_blk"]
