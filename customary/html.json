      "name": "shuts_the_open_element",
      "note": "The grammar has taken the `</` already, so this is the name alone - compared whole against the innermost tag, because a comparison of prefixes would let `</division>` close a `div`.",
      "phase": "enclosing",
      "when": [
        [
          "not_wanted",
          "_start_tag_name"
        ],
        [
          "wanted",
          "_end_tag_name"
