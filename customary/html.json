          "pop",
          "marks"
        ]
      ]
    },
    {
      "name": "shuts_nothing_and_says_so",
      "note": "A close that matches nothing open is a token over the same bytes and pops nothing: the element it failed to close is still open, so the parser recovers around the stray rather than around a hole. Named by the terminal it answers with and guarded by the one the C's dispatch tested, which are not the same terminal.",
      "phase": "enclosing",
      "when": [
        [
          "not_wanted",
          "_start_tag_name"
        ],
        [
          "wanted",
          "_end_tag_name"
        ],
        [
          "not_wanted",
          "raw_text"
        ],
        [
          "probe",
          "space_name"
        ]
      ],
      "then": [
        [
          "skip",
          [
            "span",
            1
          ]
        ],
        [
          "emit",
          "erroneous_end_tag_name",
          [
            "span",
            2
          ]
        ]
      ]
    },
