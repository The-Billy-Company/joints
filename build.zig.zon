.{
    .name = .joints,
    .version = "0.0.0", // x-release-please-version
    .fingerprint = 0x85f7afd4d1dc33e6,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The shard-aware test runner (build-time only, no artifact, no ABI).
        // Pinned rather than path-dep'd: it is a published package whose
        // version this repository should choose deliberately.
        .brigade = .{
            .url = "https://github.com/The-Billy-Company/brigade/archive/505a57a9febf21757268bd8ac651c53d27896c79.tar.gz",
            .hash = "brigade-0.1.0-1n1fSewLAQBenqvI3An0VUw24_TsuaT3mt1_4TfqWZwG",
        },
        // The regex engine and the shared search-math floor. A path dep on the
        // sibling checkout while both move together: joints is the first
        // consumer to ask irregex for an anchored longest-match slate, and the
        // two halves of that conversation should be editable in one sitting.
        // It becomes a pinned URL the moment either side stops changing.
        .irregex = .{ .path = "../irregex" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // The committed grammar fixture the test module embeds. Without it the
        // published tarball ships tests that cannot build.
        "test",
        "README.md",
        "LICENSE",
        "NOTICE",
    },
}
